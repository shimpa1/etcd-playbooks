# {{ ansible_managed }}
# Generated by playbooks/provision_proxmox_testbed.yml - feed straight into
# the generic playbook:
#   ansible-playbook -i {{ proxmox_testbed_inventory_output }} playbooks/etcd.yml
all:
  children:
    {{ proxmox_testbed_inventory_group }}:
      hosts:
{% for h in proxmox_testbed_provisioned_hosts %}
        {{ h.name }}:
          ansible_host: {{ h.ansible_host }}
          proxmox_vmid: {{ h.vmid }}
{% endfor %}
      vars:
        ansible_user: {{ proxmox_ci_user }}
